---
import '../styles/global.css';
const { title = 'Pierre Studio · Photothèque' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#202124" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Pierre Studio : vos photos, galeries et livraisons clients." />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Pierre Studio" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://api.pierre-coutherut.fr" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <noscript><p class="studio-loading">Activez JavaScript pour vous connecter et gérer vos galeries.</p></noscript>
  </body>
</html>
